# Fillosophy Backend Configuration — Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env to version control.

# AI Configuration
# Set MOCK_AI=true to use fake responses offline for free (no API key required)
MOCK_AI=false
# DEFAULT_PROVIDER: "anthropic" | "groq" | "openrouter"
# The system cascades through providers in this order if one fails.
DEFAULT_PROVIDER=anthropic

# API Keys — provide at least one.
ANTHROPIC_API_KEY=sk-ant-api03-...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...

# Supabase — required for profile storage
# Create a project at https://supabase.com, then copy from:
#   Project Settings → API → Project URL & anon/service_role key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
